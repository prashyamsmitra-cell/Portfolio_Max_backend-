# Backend Environment Variables
# Copy to .env for local development (`npm run dev` or `npm run serve`).
# In production (e.g. Vercel), set these in Project Settings -> Environment Variables.
# NONE of these should be exposed to the client browser.

# Port for local dev server (defaults to 3001)
PORT=3001

# Allowed frontend origins for CORS (comma-separated, without trailing slashes).
# Defaults to localhost dev origins (http://localhost:3000, http://localhost:5000) if unset.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-portfolio-frontend.vercel.app,https://your-portfolio-frontend.pages.dev

# GitHub Integration
# Token optional: raises rate limit from 60/h to 5000/h; a fine-grained token with no permissions is enough for public repos.
GITHUB_USERNAME=prashyamsmitra-cell
GITHUB_TOKEN=

# Supabase Database & Storage Integration
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=            # used server-side only, to verify admin sign-in
SUPABASE_SERVICE_ROLE_KEY=    # server-side only. Bypasses RLS — never commit or expose.

# Admin Authorization Allow-list
# Comma-separated emails allowed to manage posts. Create these users in Supabase -> Authentication -> Users.
ADMIN_EMAILS=you@example.com

# Local dev authentication only (used when SUPABASE_URL is unset/placeholder, and only by `npm run dev`):
# Posts then live in data/posts.json, images in uploads/, and sign-in issues a signed local token.
ADMIN_PASSWORD=            # leave blank to accept any password for an ADMIN_EMAILS address
ADMIN_SESSION_SECRET=      # leave blank to use the dev default HMAC key
